# Copy to Signing.local.properties (gitignored). Never commit the filled copy.
# Paths are relative to android/. Do not use ~; absolute paths also work.
storeFile=signing/gridzero.keystore
storePassword=REPLACE_LOCALLY
keyAlias=REPLACE_LOCALLY
keyPassword=REPLACE_LOCALLY

# For the original standard debug.keystore only, the usual values are:
# storeFile=signing/previous-debug.keystore
# storePassword=android
# keyAlias=androiddebugkey
# keyPassword=android
# This is suitable for updating an existing debug-signed sideload, NOT store release.
