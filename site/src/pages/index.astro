---
import Site from '../layouts/Site.astro';
---
<Site title="GridZero — Sudoku. Zero distractions." description="Free, open-source Sudoku. Play now in your browser, or discover GridZero for iPhone, iPad, and Android. No ads. No tracking.">
  <main id="main" class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Browser. iPhone. iPad. Android.</p>
      <h1>Sudoku.<br />Zero distractions.</h1>
      <p class="intro">A full-width board. Number buttons with room to breathe. Just you and the next possibility.</p>
      <div class="actions">
        <a class="play-link" href="/play/">Play now <span aria-hidden="true">→</span></a>
        <a class="source-link" href="https://github.com/traviseden/gridzero">View the source <span aria-hidden="true">↗</span></a>
      </div>
      <p class="promise">Free. Open source. No ads. No tracking.<br />No download needed. Your progress stays on this device.</p>
      <p class="native-status">Native iOS &amp; Android releases are coming soon.</p>
      <p class="promise">8,000 puzzles, courtesy of <a href="/credits/">Sudoku Exchange</a>.<br /><a href="/support/#install">Save it to your home screen</a> for an app-like, offline-ready experience.</p>
    </div>
    <figure class="app-preview">
      <a href="/play/" aria-label="Play GridZero">
        <picture>
          <source srcset="/assets/game-dark.png" media="(prefers-color-scheme: dark)" />
          <img src="/assets/game-light.png" alt="GridZero's Sudoku board, pencil notes, and staggered keypad: 1, 3, 5, 7, 9 above 2, 4, 6, 8." width="720" height="1558" fetchpriority="high" />
        </picture>
      </a>
      <figcaption>Thoughtfully spaced. Quietly yours.</figcaption>
    </figure>
  </main>
</Site>
